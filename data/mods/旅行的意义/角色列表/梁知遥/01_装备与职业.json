[
  {
    "type": "mutation",
    "id": "TRAVEL_LIANG_WINGCHUN",
    "name": {
      "str": "梁知遥的叶系咏春训练"
    },
    "description": "梁知遥自幼练习叶系咏春，熟悉守中用中，短桥窄马，黐手，八斩刀和六点半棍。赴美以后，她也接触过护具对练，体能训练和李小龙留下的部分武学观点，但她始终以咏春为主体，并把这些经历当作检验距离，节奏和临场反应的方法。",
    "points": 0,
    "valid": false,
    "player_display": false,
    "purifiable": false,
    "initial_ma_styles": [
      "style_wc_rework_ipman"
    ]
  },
  {
    "type": "mutation",
    "id": "TRAVEL_LIANG_OPEN_IDEALIST",
    "name": {
      "str": "开朗而内省"
    },
    "description": "梁知遥在安全和熟悉的人面前显得明快友善，面对陌生人时则会先观察，确认边界和退路。她很重视诚实，选择和个人价值，也容易把金钱，自律和计划变成获得安全感的方法。她习惯先想清楚再开口，通过独处，阅读和书写整理感受，有时会因此犹豫太久，或者熬夜把一个问题想得过分完整。玛雅曾半开玩笑地把她归进INFP，梁知遥没有认真承认，却也没有提出更合适的答案。",
    "points": 0,
    "valid": false,
    "player_display": true,
    "purifiable": false
  },
